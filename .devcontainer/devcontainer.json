{
  "name": "poc-almagentic-app",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.config/almagentic/agent,target=/run/secrets/agent,type=bind,readonly"
  ],
  "containerEnv": {
    "AGENT_APP_ID": "5179760",
    "AGENT_APP_SLUG": "almagentic-agent",
    "AGENT_REPO": "acbacb77/poc-almagentic-app",
    "AGENT_KEY_FILE": "/run/secrets/agent/agent.pem"
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends jq bubblewrap socat && pip install --user uv && npm install -g @anthropic-ai/claude-code",
  "forwardPorts": [
    8000
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
